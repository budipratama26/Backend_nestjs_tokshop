# Application Settings
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Security & Authentication
JWT_SECRET=
change_this_to_a_secure_random_secret_at_least_32_chars
# Database Configuration
# Supported types: better-sqlite3 | postgres | mysql
DB_TYPE=better-sqlite3
DB_DATABASE=database.sqlite

# External Database Settings (Required if DB_TYPE is postgres or mysql)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres_password

# APM & Observability (NestJS Observe)
OBSERVE_APP_KEY=your_observe_app_key
APP_SECRET=your_observe_app_secret